generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  passwordHash    String
  role            Role      @default(USER)
  isEmailVerified Boolean   @default(false)
  googleId        String?   @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

enum Role {
  USER
  ADMIN
  MODERATOR
}

model Category {
  id            String         @id @default(cuid())
  name          String
  description   String
  createdAt     DateTime       @default(now())
  deletedAt     DateTime?

  subCategories SubCategory[]  // 1:n relation
}

model SubCategory {
  id           String         @id @default(cuid())
  parentId     String
  name         String
  description  String
  createdAt    DateTime       @default(now())
  deletedAt    DateTime?

  category     Category       @relation(fields: [parentId], references: [id])
  products     Product[]      // 1:n relation
}

model Product {
  id           String        @id @default(cuid())
  name         String
  description  String
  summary      String
  cover        String
  categoryId   String
  createdAt    DateTime      @default(now())
  deletedAt    DateTime?

  subCategory  SubCategory   @relation(fields: [categoryId], references: [id])
  productSkus  ProductSkus[]
}

model ProductAttributes {
  id            String         @id @default(cuid())
  type          ProductAttributeTypes
  value         String
  createdAt     DateTime       @default(now())
  deletedAt     DateTime?

  sizeSkus      ProductSkus[]  @relation("SizeAttribute")
  colorSkus     ProductSkus[]  @relation("ColorAttribute")
}

enum ProductAttributeTypes {
  COLOR
  SIZE
}

model ProductSkus {
  id                String             @id @default(cuid())
  productId         String
  sizeAttributeId   String
  colorAttributeId  String
  sku               String             @unique
  price             Decimal            @db.Decimal(10, 2)
  quantity          Int
  createdAt         DateTime           @default(now())
  deletedAt         DateTime?

  product           Product            @relation(fields: [productId], references: [id])
  sizeAttribute     ProductAttributes  @relation("SizeAttribute", fields: [sizeAttributeId], references: [id])
  colorAttribute    ProductAttributes  @relation("ColorAttribute", fields: [colorAttributeId], references: [id])

  @@unique([productId, sizeAttributeId, colorAttributeId])
}